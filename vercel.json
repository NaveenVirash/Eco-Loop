{
    "version": 2,
    "builds": [
        {
            "src": "backend/server.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "build"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/server.js"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/$1"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/weekly-reset",
            "schedule": "0 0 * * 1"
        },
        {
            "path": "/api/cron/expire-products",
            "schedule": "0 0 * * *"
        }
    ]
}